# Скопируйте этот файл в .env; реальные ключи не добавляйте в репозиторий.
# Секрет приложения: демонстрационное значение замените своим случайным секретом.
SECRET_KEY=change-me-demo
# Задержка между этапами конвейера заявок в секундах.
PIPELINE_STEP_DELAY=1.2

# LLM необязательна. Адрес OpenAI-совместимого API, например cloud.ru Foundation Models:
# LLM_BASE_URL=https://foundation-models.api.cloud.ru/v1
LLM_BASE_URL=
# Ключ провайдера. При пустом ключе ИИгорь работает на правилах.
LLM_API_KEY=
# Идентификатор доступной у провайдера модели с открытыми весами из его каталога.
LLM_MODEL=

# Внешние сервисы за HTTP-контрактом (api/integrations.py). Пусто - встроенные моки. Чтобы прогнать конвейер
# через HTTP на встроенных моках: REGISTRY_URL=http://localhost:8000/api/mock/registry и т. п.
REGISTRY_URL=
BKI_URL=
NEWS_URL=

# Следующие значения заданы в docker-compose.yml и Dockerfile, а не читаются из .env:
# POSTGRES_USER=alfa — пользователь демонстрационной базы PostgreSQL.
# POSTGRES_PASSWORD=alfa — пароль демонстрационной базы PostgreSQL.
# POSTGRES_DB=alfa — имя базы PostgreSQL; данные сохраняются в томе pgdata.
# DATABASE_URL=postgresql+psycopg://alfa:alfa@db:5432/alfa — подключение приложения к сервису db.
# ENGINE_PATH=/app/models/engine.pkl — путь к модели скоринга внутри контейнера.
# WEB_DIST=/app/web/dist — каталог собранного React-приложения внутри контейнера.
# PYTHONUNBUFFERED=1 — вывод журналов Python без буферизации.
