  "components": {
    "schemas": {
      "Action": {
        "properties": {
          "action": {
            "type": "string",
            "title": "Action"
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 300000000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount"
          },
          "code": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 8
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "action"
        ],
        "title": "Action"
      },
      "Ask": {
        "properties": {
          "persona_id": {
            "type": "string",
            "title": "Persona Id"
          },
          "levers": {
            "$ref": "#/components/schemas/Levers"
          }
        },
        "type": "object",
        "required": [
          "persona_id",
          "levers"
        ],
        "title": "Ask"
      },
      "Chat": {
        "properties": {
          "persona_id": {
            "type": "string",
            "title": "Persona Id"
          },
          "levers": {
            "$ref": "#/components/schemas/Levers"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "maxItems": 40,
            "title": "Messages"
          }
        },
        "type": "object",
        "required": [
          "persona_id",
          "levers",
          "messages"
        ],
        "title": "Chat"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Levers": {
        "properties": {
          "product": {
            "type": "string",
            "title": "Product"
          },
          "requested_amount": {
            "type": "number",
            "maximum": 300000000.0,
            "minimum": 10000.0,
            "title": "Requested Amount"
          },
          "requested_term_m": {
            "type": "integer",
            "maximum": 120.0,
            "minimum": 1.0,
            "title": "Requested Term M"
          },
          "has_rko": {
            "type": "boolean",
            "title": "Has Rko",
            "default": false
          },
          "bank_turnover_month_rub": {
            "type": "number",
            "maximum": 10000000000.0,
            "minimum": 0.0,
            "title": "Bank Turnover Month Rub",
            "default": 0
          },
          "guarantee": {
            "type": "boolean",
            "title": "Guarantee",
            "default": false
          },
          "marketplace": {
            "type": "boolean",
            "title": "Marketplace",
            "default": false
          },
          "insurance": {
            "type": "boolean",
            "title": "Insurance",
            "default": false
          },
          "subscription": {
            "type": "boolean",
            "title": "Subscription",
            "default": false
          },
          "bki_consent": {
            "type": "boolean",
            "title": "Bki Consent",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "product",
          "requested_amount",
          "requested_term_m"
        ],
        "title": "Levers",
        "description": "Что клиент меняет сам. Лишние поля (выручка, БКИ…) отбрасываются: факты - только из демо-компании."
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "Message": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 4000,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "Message"
      },
      "Submit": {
        "properties": {
          "persona_id": {
            "type": "string",
            "title": "Persona Id"
          },
          "levers": {
            "$ref": "#/components/schemas/Levers"
          },
          "purpose": {
            "type": "string",
            "maxLength": 500,
            "title": "Purpose",
            "default": ""
          },
          "bki_consent": {
            "type": "boolean",
            "title": "Bki Consent",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "persona_id",
          "levers"
        ],
        "title": "Submit"
      },
      "Sweep": {
        "properties": {
          "persona_id": {
            "type": "string",
            "title": "Persona Id"
          },
          "levers": {
            "$ref": "#/components/schemas/Levers"
          },
          "axis": {
            "type": "string",
            "enum": [
              "requested_amount",
              "requested_term_m"
            ],
            "title": "Axis",
            "default": "requested_amount"
          },
          "n": {
            "type": "integer",
            "maximum": 64.0,
            "minimum": 4.0,
            "title": "N",
            "default": 32
          }
        },
        "type": "object",
        "required": [
          "persona_id",
          "levers"
        ],
        "title": "Sweep"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}